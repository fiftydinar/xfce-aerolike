#!/bin/bash
# Update unbound forward zones on VPN connect/disconnect for split-DNS

ACTION="$2"
DOMAIN_DIR="/run/unbound-vpn-domains"

case "$ACTION" in
    vpn-up)
        DNS_SERVERS="${VPN_IP4_NAMESERVERS:-$VPN_IP6_NAMESERVERS}"
        [ -z "$DNS_SERVERS" ] && exit 0

        DNS_DOMAINS=$(nmcli -g ipv4.dns-search con show "$CONNECTION_UUID" 2>/dev/null)
        [ -z "$DNS_DOMAINS" ] && DNS_DOMAINS=$(nmcli -g ipv6.dns-search con show "$CONNECTION_UUID" 2>/dev/null)
        [ -z "$DNS_DOMAINS" ] && exit 0

        mkdir -p "$DOMAIN_DIR"
        for domain in $DNS_DOMAINS; do
            echo "$domain" >> "$DOMAIN_DIR/$CONNECTION_UUID"
            for server in $DNS_SERVERS; do
                unbound-control forward_add +i "$domain" "$server"
            done
        done
        ;;
    up)
        CONN_TYPE=$(nmcli -g connection.type con show "$CONNECTION_UUID" 2>/dev/null)
        [ "$CONN_TYPE" != "wireguard" ] && exit 0

        DNS_SERVERS=$(nmcli -g ipv4.dns con show "$CONNECTION_UUID" 2>/dev/null)
        [ -z "$DNS_SERVERS" ] && DNS_SERVERS=$(nmcli -g ipv6.dns con show "$CONNECTION_UUID" 2>/dev/null)
        [ -z "$DNS_SERVERS" ] && exit 0

        DNS_DOMAINS=$(nmcli -g ipv4.dns-search con show "$CONNECTION_UUID" 2>/dev/null)
        [ -z "$DNS_DOMAINS" ] && DNS_DOMAINS=$(nmcli -g ipv6.dns-search con show "$CONNECTION_UUID" 2>/dev/null)
        [ -z "$DNS_DOMAINS" ] && exit 0

        mkdir -p "$DOMAIN_DIR"
        for domain in $DNS_DOMAINS; do
            echo "$domain" >> "$DOMAIN_DIR/$CONNECTION_UUID"
            for server in $DNS_SERVERS; do
                unbound-control forward_add +i "$domain" "$server"
            done
        done
        ;;
    vpn-down)
        DOMAIN_FILE="$DOMAIN_DIR/$CONNECTION_UUID"
        [ -f "$DOMAIN_FILE" ] || exit 0
        while read -r domain; do
            unbound-control forward_remove "$domain" 2>/dev/null
        done < "$DOMAIN_FILE"
        rm -f "$DOMAIN_FILE"
        ;;
    down)
        CONN_TYPE=$(nmcli -g connection.type con show "$CONNECTION_UUID" 2>/dev/null)
        [ "$CONN_TYPE" != "wireguard" ] && exit 0
        DOMAIN_FILE="$DOMAIN_DIR/$CONNECTION_UUID"
        [ -f "$DOMAIN_FILE" ] || exit 0
        while read -r domain; do
            unbound-control forward_remove "$domain" 2>/dev/null
        done < "$DOMAIN_FILE"
        rm -f "$DOMAIN_FILE"
        ;;
esac
