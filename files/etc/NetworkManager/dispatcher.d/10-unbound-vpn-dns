#!/bin/sh
# Update unbound forward zones on VPN connect/disconnect for split-DNS.
# POSIX sh. Uses flock via util-linux for concurrency safety.

set -eu

ACTION="${2}"
CONN_UUID="${CONNECTION_UUID:-}"
LOCKFILE="/run/unbound-vpn-dns/lock"
DOMAIN_DIR="/run/unbound-vpn-dns/domains"
UC_TIMEOUT="5"

_log() {
    logger -t "unbound-vpn-dns" "$@"
}

_wait_unbound() {
    i=1
    while [ "$i" -le 10 ]; do
        if timeout 2 unbound-control status >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    _log "unbound-control not available after 10s, skipping"
    return 1
}

_get_dns_servers() {
    uuid="$1"
    servers=""
    servers=$(nmcli -g ipv4.dns con show "$uuid" 2>/dev/null || true)
    if [ -z "$servers" ]; then
        servers=$(nmcli -g ipv6.dns con show "$uuid" 2>/dev/null || true)
    fi
    echo "$servers"
}

_get_search_domains() {
    uuid="$1"
    domains=""
    domains=$(nmcli -g ipv4.dns-search con show "$uuid" 2>/dev/null || true)
    if [ -z "$domains" ]; then
        domains=$(nmcli -g ipv6.dns-search con show "$uuid" 2>/dev/null || true)
    fi
    echo "$domains"
}

_add_forward_zone() {
    domain="$1"; servers="$2"
    for s in $servers; do
        if timeout "$UC_TIMEOUT" unbound-control forward_add +i "$domain" "$s" >/dev/null 2>&1; then
            _log "forward_add $domain -> $s"
        else
            _log "forward_add $domain -> $s FAILED"
        fi
    done
}

_remove_forward_zone() {
    domain="$1"
    if timeout "$UC_TIMEOUT" unbound-control forward_remove "$domain" >/dev/null 2>&1; then
        _log "forward_remove $domain"
    else
        _log "forward_remove $domain (no-op)"
    fi
}

# Remove stale domain files for connections that no longer exist
_reconcile_stale() {
    if [ ! -d "$DOMAIN_DIR" ]; then
        return
    fi
    active=$(nmcli -t con show --active 2>/dev/null | cut -d: -f2 || true)
    for f in "$DOMAIN_DIR"/*; do
        [ -f "$f" ] || continue
        uuid=$(basename "$f")
        match=$(echo "$active" | grep -Fx "$uuid" || true)
        if [ -z "$match" ]; then
            _log "reconcile: removing stale state for $uuid"
            while read -r domain; do
                _remove_forward_zone "$domain"
            done < "$f"
            rm -f "$f"
        fi
    done
}

_handle_up() {
    uuid="$1"
    servers=$(_get_dns_servers "$uuid")
    [ -z "$servers" ] && return

    domains=$(_get_search_domains "$uuid")
    [ -z "$domains" ] && return

    mkdir -p "$DOMAIN_DIR"
    for domain in $domains; do
        echo "$domain" >> "$DOMAIN_DIR/$uuid"
        _add_forward_zone "$domain" "$servers"
    done
}

_handle_down() {
    uuid="$1"
    domain_file="$DOMAIN_DIR/$uuid"

    [ -f "$domain_file" ] || return

    while read -r domain; do
        _remove_forward_zone "$domain"
    done < "$domain_file"
    rm -f "$domain_file"
}

exec 9>"$LOCKFILE"
flock -x 9

mkdir -p "$DOMAIN_DIR"

_wait_unbound || exit 0

_reconcile_stale

case "$ACTION" in
    vpn-up)
        _handle_up "$CONN_UUID"
        ;;
    up)
        conn_type=$(nmcli -g connection.type con show "$CONN_UUID" 2>/dev/null || true)
        [ "$conn_type" = "wireguard" ] || exit 0
        _handle_up "$CONN_UUID"
        ;;
    vpn-down)
        _handle_down "$CONN_UUID"
        ;;
    down)
        conn_type=$(nmcli -g connection.type con show "$CONN_UUID" 2>/dev/null || true)
        [ "$conn_type" = "wireguard" ] || exit 0
        _handle_down "$CONN_UUID"
        ;;
esac
