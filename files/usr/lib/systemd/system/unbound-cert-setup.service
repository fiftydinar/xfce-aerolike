[Unit]
Description=Set up unbound-control TLS certificates
Before=unbound.service

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'test -f /etc/unbound/unbound_server.pem || /usr/bin/unbound-control-setup || true'
ExecStart=/usr/bin/chown -R unbound:unbound /etc/unbound
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
