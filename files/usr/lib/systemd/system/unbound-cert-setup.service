[Unit]
Description=Generate unbound-control TLS certificates
ConditionPathExists=!/etc/unbound/unbound_server.pem
Before=unbound.service

[Service]
Type=oneshot
ExecStart=/usr/bin/unbound-control-setup
ExecStartPost=/usr/bin/chown -R unbound:unbound /etc/unbound/unbound_server.key /etc/unbound/unbound_server.pem /etc/unbound/unbound_control.key /etc/unbound/unbound_control.pem

[Install]
WantedBy=multi-user.target
