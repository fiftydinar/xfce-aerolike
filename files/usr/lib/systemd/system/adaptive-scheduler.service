[Unit]
Description=Adaptive scheduler: working-set trim, memory priority gradation, CPU nice
Documentation=man:adaptive-scheduler(1)
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/adaptive-scheduler
Restart=on-failure
# Runs as root: process_madvise(MADV_COLD) cross-process requires
# CAP_SYS_NICE, which unprivileged users lack. Root also lets one daemon
# coordinate across all user sessions.
# Drop other privileges/caps; we only need CAP_SYS_NICE.
CapabilityBoundingSet=CAP_SYS_NICE
AmbientCapabilities=CAP_SYS_NICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
