#!/bin/sh
# aerolike-fg: report the active X window's PID to the adaptive-scheduler
# root daemon.
#
# Runs as a systemd user service inside the graphical session, where
# DISPLAY and XAUTHORITY are set. The root daemon cannot reach the user's
# X auth (it drops CAP_SYS_PTRACE and CAP_DAC_OVERRIDE), so an
# unprivileged reporter in the session is the only reliable path. The
# active window PID is written to /tmp/aerolike-fg-<uid> (world-readable)
# once per second; the daemon reads it to classify the foreground tier.

while :; do
    fg=$(xdotool getactivewindow getwindowpid 2>/dev/null)
    case $fg in
        ''|*[!0-9]*) : ;;
        *) printf '%s\n' "$fg" > "/tmp/aerolike-fg-$(id -u)" ;;
    esac
    sleep 1
done
