+void QXcbScreen::updateHighDpiScaleFactor()
+{
+    qreal factor;
+    const bool hasFactor = readHighDpiScaleFactor(&factor);
+
+    if (hasFactor == hasHighDpiScaleFactor() && (!hasFactor || qFuzzyCompare(factor, highDpiScaleFactor())))
+        return;
+
+    const qreal oldFactor = QHighDpiScaling::factor(this);
+    if (hasFactor)
+        setHighDpiScaleFactor(factor);
+    else
+        clearHighDpiScaleFactor();
+
+    // QXcbScreen::screen() returns xcb_screen_t*, which hides this one.
+    QScreen *qscreen = QPlatformScreen::screen();
+    if (!qscreen)
+        return;
+
+    // The factor is read lazily by QHighDpiScaling, so this only recomputes the
+    // global bookkeeping; the new value is picked up by factor(this) below.
+    QHighDpiScaling::updateHighDpiScaling();
+
+    const QDpi dpi = logicalDpi();
+    QXcbWindow::rescale(windows(), oldFactor, QHighDpiScaling::factor(this), [qscreen, dpi] {
+        QWindowSystemInterface::handleScreenLogicalDotsPerInchChange(qscreen, dpi.first, dpi.second);
+    });
+}
