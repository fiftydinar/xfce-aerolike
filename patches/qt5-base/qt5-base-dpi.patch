+bool QXcbScreen::readHighDpiScaleFactor(qreal *factor) const
+{
+    if (!connection()->hasXRandr() || m_output == XCB_NONE)
+        return false;
+
+    // The phoenix server publishes the scale each output is meant to be shown at
+    // as a RandR output property, because it cannot scale X11 clients itself.
+    auto reply = Q_XCB_REPLY(xcb_randr_get_output_property, xcb_connection(),
+                             m_output, atom(QXcbAtom::DPI), XCB_ATOM_INTEGER, 0, 1, false, false);
+    if (!reply || reply->type != XCB_ATOM_INTEGER || reply->format != 32 || reply->num_items != 1)
+        return false;
+
+    const int32_t dpi = *reinterpret_cast<const int32_t *>(xcb_randr_get_output_property_data(reply.get()));
+    if (dpi <= 0)
+        return false;
+
+    *factor = dpi / logicalBaseDpi().first;
+    return true;
+}
