+void
+PrivateWindow::autoDetectFullscreen ()
+{
+    if (priv->attrib.override_redirect || !priv->managed)
+	return;
+
+    if (!(priv->wmType & (CompWindowTypeNormalMask | CompWindowTypeUnknownMask)))
+	return;
+
+    int outputDev = screen->outputDeviceForGeometry (priv->frameGeometry);
+    CompOutput &output = screen->outputDevs ().at (outputDev);
+
+    bool coversOutput =
+	priv->frameGeometry.x () == output.x () &&
+	priv->frameGeometry.y () == output.y () &&
+	priv->frameGeometry.x () + priv->frameGeometry.width ()  == output.x () + output.width () &&
+	priv->frameGeometry.y () + priv->frameGeometry.height () == output.y () + output.height ();
+
+    if (coversOutput && !(priv->state & CompWindowStateFullscreenMask))
+    {
+	window->changeState (priv->state | CompWindowStateFullscreenMask);
+	window->updateAttributes (CompStackingUpdateModeNormal);
+    }
+    else if (!coversOutput && (priv->state & CompWindowStateFullscreenMask))
+    {
+	window->changeState (priv->state & ~CompWindowStateFullscreenMask);
+	window->updateAttributes (CompStackingUpdateModeNormal);
+    }
+}
