+void
+PrivateWindow::autoDetectFullscreen ()
+{
+    int wX2, wY2;
+
+    if (priv->attrib.override_redirect || !priv->managed)
+	return;
+
+    if (!(priv->wmType & (CompWindowTypeNormalMask | CompWindowTypeUnknownMask)))
+	return;
+
+    if (priv->state & CompWindowStateFullscreenMask)
+	return;
+
+    wX2 = priv->frameGeometry.x () + priv->frameGeometry.width ();
+    wY2 = priv->frameGeometry.y () + priv->frameGeometry.height ();
+
+    /* Test every output instead of screen->fullscreenOutput (). The latter is
+     * the bounding box of all monitors (PrivateScreen::reshape sets it to
+     * (0, 0, screenW, screenH)), so on a server that keeps a framebuffer per
+     * monitor it misses the normal case - a window filling exactly one
+     * monitor - and instead matches a window spanning every monitor. Testing
+     * containment per output keeps the spanning case working too, since such a
+     * window contains each output as well. */
+    foreach (CompOutput &o, screen->outputDevs ())
+    {
+	if (priv->frameGeometry.x () <= o.x () &&
+	    priv->frameGeometry.y () <= o.y () &&
+	    wX2 >= o.x () + o.width () &&
+	    wY2 >= o.y () + o.height ())
+	{
+	    window->changeState (priv->state | CompWindowStateFullscreenMask);
+	    window->updateAttributes (CompStackingUpdateModeNormal);
+	    break;
+	}
+    }
+}
