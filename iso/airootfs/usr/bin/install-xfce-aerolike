#!/bin/sh
set -eu

ROOT="${1:-}"
IMAGE_ARCHIVE="/opt/install/xfce-aerolike.tar.zst"
IMAGE_REF_FILE="/opt/install/image-ref"
DEFAULT_IMAGE="ghcr.io/fiftydinar/xfce-aerolike:latest"

[ -z "$ROOT" ] && { echo "ERROR: target root not specified"; exit 1; }

echo "Installing xfce-aerolike to ${ROOT}..."

EMPTY_OVERLAY="/tmp/.empty-overlay"
mkdir -p "$EMPTY_OVERLAY"

# ---- Container storage (target disk) ----
mkdir -p "${ROOT}/var/lib/containers-staging" /var/lib/containers/storage
mount --bind "${ROOT}/var/lib/containers-staging" /var/lib/containers/storage
mount --bind "$EMPTY_OVERLAY" "${ROOT}/var/lib/containers-staging"

# ---- Skopeo temp dir (target disk) ----
# containers/image hardcodes /var/tmp for big temp files, ignoring $TMPDIR.
# Bind mount a staging dir on the target ext4 over /var/tmp so skopeo's
# archive decompression has enough space.
SKOPEO_TMP="${ROOT}/.skopeo-tmp"
mkdir -p "$SKOPEO_TMP"
mount --bind "$SKOPEO_TMP" /var/tmp

# ---- Bootc temp dir (target disk) ----
# bootc (Rust) reads $TMPDIR via std::env::temp_dir.
# Create a host-accessible path, then overlay it so bootc's require_empty_rootdir
# sees an empty dir.
mkdir -p "${ROOT}/tmp" /mnt/target-tmp
mount --bind "${ROOT}/tmp" /mnt/target-tmp
mount --bind "$EMPTY_OVERLAY" "${ROOT}/tmp"
export TMPDIR=/mnt/target-tmp

# ---- Storage config (kernel overlay, no mount_program) ----
STORAGE_CONF="/tmp/bootc-storage.conf"
cat > "$STORAGE_CONF" << 'STORAGECONF'
[storage]
driver = "overlay"
STORAGECONF
export CONTAINERS_STORAGE_CONF="$STORAGE_CONF"

INSTALL_MODE="offline"
if [ -f /opt/install/install-mode ]; then
    INSTALL_MODE=$(cat /opt/install/install-mode)
fi

IMAGE_NAME="${DEFAULT_IMAGE}"
if [ "${INSTALL_MODE}" = "offline" ] && [ -f "${IMAGE_ARCHIVE}" ]; then
    echo "Installing in OFFLINE mode..."
    skopeo copy "docker-archive:${IMAGE_ARCHIVE}" "containers-storage:${IMAGE_NAME}"
elif [ "${INSTALL_MODE}" = "online" ]; then
    if [ -f "${IMAGE_REF_FILE}" ]; then
        TAG=$(cat "${IMAGE_REF_FILE}" | sed 's/.*://')
        TAG_PREFIX=$(printf '%s' "$TAG" | sed 's/[0-9]\{8\}$//')
        if [ -n "$TAG_PREFIX" ]; then
            LATEST=$(skopeo list-tags "docker://ghcr.io/fiftydinar/xfce-aerolike" 2>/dev/null | \
                jq -r --arg p "$TAG_PREFIX" '.Tags[] | select(. | startswith($p))' | sort -r | head -1)
            if [ -n "$LATEST" ]; then
                IMAGE_NAME="ghcr.io/fiftydinar/xfce-aerolike:${LATEST}"
            fi
        fi
    fi
    echo "Installing in ONLINE mode..."
    skopeo copy "docker://${IMAGE_NAME}" "containers-storage:${IMAGE_NAME}"
fi

# ---- Restore /var/tmp (remove bind mount to target) ----
# After skopeo finishes, unmount the /var/tmp bind mount and remove the staging dir.
umount /var/tmp
rm -rf "$SKOPEO_TMP"

echo "Running bootc install to-filesystem..."
bootc install to-filesystem \
    --source-imgref "containers-storage:${IMAGE_NAME}" \
    --skip-fetch-check \
    --bootloader grub \
    --target-imgref "${IMAGE_NAME}" \
    "${ROOT}"

echo "Cleanup..."
umount "${ROOT}/var/lib/containers-staging" 2>/dev/null || true
umount /var/lib/containers/storage 2>/dev/null || true
umount "${ROOT}/tmp" 2>/dev/null || true
umount /mnt/target-tmp 2>/dev/null || true
rm -rf "${ROOT}/var/lib/containers-staging" "${ROOT}/tmp" "${STORAGE_CONF}" "${EMPTY_OVERLAY}"

echo "Installation complete!"
