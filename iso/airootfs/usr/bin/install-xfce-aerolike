#!/bin/sh
set -eu

ROOT="${1:-}"
IMAGE_ARCHIVE="/opt/install/xfce-aerolike.tar.zst"
IMAGE_REF_FILE="/opt/install/image-ref"
DEFAULT_IMAGE="ghcr.io/fiftydinar/xfce-aerolike:latest"

[ -z "$ROOT" ] && { echo "ERROR: target root not specified"; exit 1; }

echo "Installing xfce-aerolike to ${ROOT}..."

# Use storage on the target disk (real filesystem) to avoid filling up
# the live ISO's small tmpfs with container image layers.
# Bind-mount it to the default podman storage path so that bootc's
# imageid_to_digest (which runs podman inspect in the host mount namespace
# via /proc/1/ns/mnt) finds the image at the expected location.
mkdir -p "${ROOT}/var/lib/containers-staging" /var/lib/containers/storage
mount --bind "${ROOT}/var/lib/containers-staging" /var/lib/containers/storage
STORAGE_ROOT="/var/lib/containers/storage"

export TMPDIR="${ROOT}/tmp"
mkdir -p "$TMPDIR"

INSTALL_MODE="offline"
if [ -f /opt/install/install-mode ]; then
    INSTALL_MODE=$(cat /opt/install/install-mode)
fi

IMAGE_NAME="${DEFAULT_IMAGE}"
if [ "${INSTALL_MODE}" = "offline" ] && [ -f "${IMAGE_ARCHIVE}" ]; then
    echo "Installing in OFFLINE mode (loading image from ${IMAGE_ARCHIVE})..."
    zstd -d -c "${IMAGE_ARCHIVE}" | podman load
    if [ -f "${IMAGE_REF_FILE}" ]; then
        IMAGE_NAME=$(cat "${IMAGE_REF_FILE}")
    fi
else
    if [ -f "${IMAGE_REF_FILE}" ]; then
        TAG=$(cat "${IMAGE_REF_FILE}" | sed 's/.*://')
        TAG_PREFIX=$(printf '%s' "$TAG" | sed 's/[0-9]\{8\}$//')
        if [ -n "$TAG_PREFIX" ]; then
            LATEST=$(skopeo list-tags "docker://ghcr.io/fiftydinar/xfce-aerolike" 2>/dev/null | \
                jq -r --arg p "$TAG_PREFIX" '.Tags[] | select(. | startswith($p))' | sort -r | head -1)
            if [ -n "$LATEST" ]; then
                IMAGE_NAME="ghcr.io/fiftydinar/xfce-aerolike:${LATEST}"
            fi
        fi
    fi
    echo "Installing in ONLINE mode, pulling ${IMAGE_NAME}..."
    podman pull "${IMAGE_NAME}"
fi

# Configure podman storage inside bootc container to use fuse-overlayfs
# and point graphroot to the default storage path.
mkdir -p "${ROOT}/etc/containers"
cat > "${ROOT}/etc/containers/storage.conf" << 'STORAGECONF'
[storage]
driver = "overlay"

[storage.options]
mount_program = "/usr/bin/fuse-overlayfs"
STORAGECONF
# Also fix newuidmap setuid (needed for podman on Arch)
chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap 2>/dev/null || true

echo "Running bootc install to-filesystem using image ${IMAGE_NAME}..."
podman run --rm --privileged --pid=host --ipc=host \
    -e CONTAINERS_STORAGE_CONF=/etc/containers/storage.conf \
    -v /dev:/dev \
    -v /dev/fuse:/dev/fuse \
    -v "${ROOT}:/target" \
    -v /var/lib/containers/storage:/var/lib/containers/storage:rslave \
    -v "${ROOT}/etc/containers/storage.conf:/etc/containers/storage.conf" \
    -v /usr/bin/fuse-overlayfs:/usr/bin/fuse-overlayfs:ro \
    -v /usr/bin/fusermount3:/usr/bin/fusermount3:ro \
    -v /usr/lib/libfuse3.so.4:/usr/lib/libfuse3.so.4:ro \
    "${IMAGE_NAME}" \
    bootc install to-filesystem \
        --bootloader grub \
        --target-imgref "${IMAGE_NAME}" \
        /target

echo "Unmounting host storage bind mount..."
umount /var/lib/containers/storage 2>/dev/null || true

echo "Cleaning up staging storage..."
rm -rf "${ROOT}/var/lib/containers-staging" "${TMPDIR}"

echo "Installation complete!"
