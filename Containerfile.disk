FROM ghcr.io/fiftydinar/xfce-aerolike:latest

# bootc-image-builder requires PLATFORM_ID for non-Fedora containers
RUN grep -q PLATFORM_ID /etc/os-release || echo 'PLATFORM_ID="platform:rolling"' >> /etc/os-release

# Create a default user so the disk image boots to a usable login
RUN useradd -m -G wheel liveuser && echo 'liveuser:liveuser' | chpasswd && echo 'liveuser ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers.d/liveuser
